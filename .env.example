# ==========================================================
# 环境变量模板 —— 复制为 .env 并填入真实值
# .env 已被 .gitignore 忽略，切勿提交到仓库
# ==========================================================

# ---------- MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ai_doc_qa
MYSQL_USERNAME=root
MYSQL_PASSWORD=你的MySQL密码

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- JWT 签名密钥（必填，长度 >= 32 字符） ----------
# 生成方式示例：openssl rand -base64 48
AIDOC_JWT_SECRET=请替换为随机生成的32位以上密钥

# ---------- 大模型（OpenAI 兼容接口，必填） ----------
AIDOC_LLM_BASE_URL=https://api.deepseek.com/v1
AIDOC_LLM_MODEL=deepseek-chat
# 改用通义千问：https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-plus
# 改用智谱 GLM：https://open.bigmodel.cn/api/paas/v4 + glm-4-plus
AIDOC_LLM_API_KEY=sk-你的大模型APIKey

# ---------- 向量化 Embedding（选填） ----------
# 全部留空时自动降级为本地 TF-IDF 稀疏向量，无需任何外部依赖
# 填写后自动改用语义向量检索，召回质量更高
AIDOC_EMBEDDING_BASE_URL=
AIDOC_EMBEDDING_MODEL=
AIDOC_EMBEDDING_API_KEY=

# ---------- 内置演示账号（选填，不填则用默认值） ----------
AIDOC_ADMIN_USERNAME=admin
AIDOC_ADMIN_PASSWORD=admin123
AIDOC_DEMO_USERNAME=demo
AIDOC_DEMO_PASSWORD=demo123
